---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout title={`404 - ${site.name}`}>
  <main class="w-full max-w-xl px-6 py-12 text-center">
    <p class="text-2xl font-bold text-white">Error 404</p>
    <p class="mt-4 text-slate-200">Disculpa, la página que buscabas no existe.</p>
    <p class="mt-4">
      Regresa al
      <a href="/" class="underline text-sky-300 hover:text-sky-500">inicio</a>.
    </p>
  </main>
</Layout>
