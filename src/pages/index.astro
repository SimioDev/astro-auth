---
import Layout from '../layouts/Layout.astro';
import {
  SignedIn,
  SignedOut,
  SignInButton,
  SignUpButton,
  UserButton,
} from '@clerk/astro/components';
import { site } from '../config/site';
---

<Layout title={`Inicio - ${site.name}`}>
  <main class="w-full max-w-3xl px-6 py-12">
    <p class="text-sm uppercase tracking-[0.25em] text-slate-300">Plantilla lista para usar</p>
    <h1 class="mt-4 text-4xl font-bold text-white">{site.name}</h1>
    <p class="mt-3 text-lg text-slate-200">{site.description}</p>

    <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-6">
      <SignedOut>
        <p class="text-base text-slate-100">Inicia sesión o crea una cuenta para acceder al dashboard.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <SignInButton
            mode="modal"
            class="text-white bg-gradient-to-r from-emerald-400 via-emerald-500 to-emerald-600 hover:bg-gradient-to-br focus:ring-4 focus:outline-none focus:ring-emerald-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center"
          />
          <SignUpButton
            mode="modal"
            class="text-white bg-gradient-to-r from-sky-400 via-sky-500 to-sky-600 hover:bg-gradient-to-br focus:ring-4 focus:outline-none focus:ring-sky-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center"
          />
        </div>
      </SignedOut>

      <SignedIn>
        <div class="flex flex-wrap items-center gap-3">
          <UserButton showName />
          <span class="text-slate-200">Sesión iniciada correctamente.</span>
        </div>
        <p class="mt-4 text-slate-200">
          Ir al
          <a class="underline text-sky-300 hover:text-sky-500" href="/dashboard">dashboard</a>.
        </p>
      </SignedIn>
    </div>

    <div class="mt-8 text-sm text-slate-300">
      <p>Personaliza el nombre y la descripción en <code>src/config/site.ts</code>.</p>
      <p>Define rutas protegidas en <code>src/config/auth.ts</code>.</p>
    </div>
  </main>
</Layout>
