---
import { site } from '../config/site';

const {
	title = site.name,
	description = site.description,
	lang = site.locale,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div id="root" class="w-full h-full flex flex-col items-center justify-center bg-cyan-950 text-white">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	@import 'tailwindcss';
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
